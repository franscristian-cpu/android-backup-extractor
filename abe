#!/bin/sh

# Cek apakah sedang di lingkungan Cygwin (Windows POSIX compatibility layer)
command -v cygpath >/dev/null 2>&1
on_cygwin=$(( $? == 0 ? 1 : 0 ))

# Ambil jalur JAVA
if [ "$on_cygwin" = 1 ] && [ "$JAVA" ]; then
    java=$(cygpath --unix "$JAVA")
else
    java=$JAVA
fi

if [ "$on_cygwin" = 1 ] && [ "$JAVA_HOME" ]; then
    java_home=$(cygpath --unix "$JAVA_HOME")
else
    java_home=$JAVA_HOME
fi

# Gunakan JAVA dari JAVA atau JAVA_HOME, fallback ke /usr/bin/java
: "${java:=${java_home}/bin/java}"

# Resolusi path ke direktori dasar
executable="$0"
if command -v readlink >/dev/null 2>&1; then
    while target=$(readlink "$executable"); do
        [ "$executable" = "$target" ] && break
        executable="$target"
    done
fi
basedir=$(cd "$(dirname "$executable")" && pwd)

# 🔧 Perbaiki classpath (classpath)
cp="$basedir:$basedir/bin:$basedir/abe.jar"
for f in "$basedir"/lib/*.jar; do
    if [ -e "$f" ]; then
        cp="$cp:$f"
    else
        echo "WARNING: No jars found in lib directory. BouncyCastle may be missing. Expected: $f" >&2
    fi
done

# Validasi keberadaan abe.jar
if [ ! -e "$basedir/abe.jar" ]; then
    echo "ERROR: Could not find abe.jar in $basedir; did you compile with ant or mvn?" >&2
    exit 1
fi

# Validasi Java
if [ ! -x "$java" ]; then
    echo "ERROR: Java executable not found or not executable at: $java" >&2
    exit 1
fi

# Konversi classpath di Cygwin ke format Windows
if [ "$on_cygwin" = 1 ]; then
    unix_cp="$cp"
    IFS=:
    set -f
    cp=""
    for element in $unix_cp; do
        [ "$element" ] || continue
        cp="$cp;$(cygpath --windows "$element")"
    done
fi

# Jalankan aplikasi
exec "$java" -cp "$cp" org.nick.abe.Main "$@"
